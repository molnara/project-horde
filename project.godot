; Project Horde — approved Godot 4.7.2 Standard / GDScript baseline.
; Phase 1 bootstrap only; encounter components arrive in later phases.
config_version=5

[application]

config/name="Project Horde"
run/main_scene="res://scenes/main.tscn"
run/max_fps=0
config/features=PackedStringArray("4.7", "Forward Plus")
config/use_custom_user_dir=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[input]

move_forward={
"deadzone": 0.0,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_backward={
"deadzone": 0.0,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.0,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.0,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
pause_toggle={
"deadzone": 0.0,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
scaling_3d/scale=1.0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
